<?xml version="1.0"?>
<package format="3">
  <name>swas_bringup</name>
  <version>0.1.0</version>
  <description>Additive SWAS session composition; first milestone is simulation inspection only.</description>
  <maintainer email="lapo.veca@gmail.com">lapo11</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>swas_simulation</exec_depend>
  <exec_depend>swas_hmi</exec_depend>
  <export><build_type>ament_cmake</build_type></export>

  <!-- Manual-only simulation platform runtime dependencies. -->
